{
  "name": "cms",
  "version": "0.1.0",
  "description": "中惠文化官网后台 CMS（Payload + PostgreSQL + 静态生成）",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "build:generator": "node scripts/build-generator.mjs",
    "generate": "npm run build:generator && cross-env NODE_ENV=production node generator/generate.mjs",
    "migrate:about-aupair": "tsx scripts/migrate-about-aupair.ts",
    "migrate:about-company-richtext": "tsx scripts/migrate-about-company-richtext.ts",
    "migrate:contact": "tsx scripts/migrate-contact.ts",
    "migrate:cases": "tsx scripts/migrate-cases.ts",
    "migrate:about-teachers-richtext": "tsx scripts/migrate-about-teachers-richtext.ts",
    "migrate:study-abroad": "tsx scripts/migrate-study-abroad.ts",
    "migrate:study-abroad-richtext": "tsx scripts/migrate-study-abroad-richtext.ts",
    "migrate:new-zealand": "tsx scripts/migrate-new-zealand.ts",
    "build:iccp": "tsx scripts/build-iccp-page.ts",
    "build:swt": "tsx scripts/build-swt-page.ts",
    "build:itp": "tsx scripts/build-itp-page.ts",
    "menu:projects": "tsx scripts/update-project-menu.ts",
    "link:home-stories": "tsx scripts/link-home-stories.ts",
    "seed:menu": "tsx scripts/seed-menu.ts",
    "migrate:about-philosophy": "tsx scripts/migrate-about-philosophy.ts",
    "update:project-copy": "tsx scripts/update-project-copy.ts",
    "cleanup:test-content": "tsx scripts/cleanup-test-content.ts",
    "update:site-placeholders": "tsx scripts/update-site-placeholders.ts"
  },
  "dependencies": {
    "@lexical/link": "^0.50.0",
    "@lexical/list": "^0.50.0",
    "@lexical/react": "^0.50.0",
    "@lexical/rich-text": "^0.50.0",
    "@lexical/selection": "^0.50.0",
    "@payloadcms/db-postgres": "3.90.2",
    "@payloadcms/next": "3.90.2",
    "@payloadcms/richtext-lexical": "3.90.2",
    "@payloadcms/translations": "3.90.2",
    "@payloadcms/ui": "3.90.2",
    "cross-env": "^7.0.3",
    "dotenv": "16.4.7",
    "graphql": "^16.8.1",
    "lexical": "^0.50.0",
    "next": "16.3.3",
    "payload": "3.90.2",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sharp": "0.35.4",
    "swiper": "^8.4.7"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "22.19.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "esbuild": "^0.25.12",
    "jsdom": "^30.1.3",
    "tsx": "4.22.4",
    "typescript": "5.7.3",
    "vitest": "^4.0.18",
    "yaml": "^2.9.1"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
