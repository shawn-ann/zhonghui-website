# macOS
.DS_Store

# 超过 GitHub 100MB 限制的大文件（PPT 素材库）
*.pptx

# Playwright MCP 生成的临时截图/日志
.playwright-mcp/
memory-slider-*.png
pink-*.png
proj-band-*.png
full-home-*.png
banner-*.png
footer-*.png
